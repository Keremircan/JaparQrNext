# JaparQrNext (PWA) ortam değişkenleri. Bu dosyayı .env.local olarak kopyalayıp doldurun;
# Vercel için aynı değişkenleri Project Settings > Environment Variables altına girin.

# Veritabanı (Supabase Postgres) bağlantısı
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
# İsteğe bağlı: Supabase CA sertifikası (PEM). Tanımlıysa sunucu sertifikası doğrulanır.
DB_CA_CERT=

# Karekod sırları: kiosk (japar-kiosk) sunucusundakilerle BİREBİR aynı olmalı.
# SHARED_SECRET_BASE32: en az 32 karakter Base32 (A-Z, 2-7). AES_SECRET_KEY: en az 32 karakter.
# Eksik, zayıf veya örnek değerlerle karekod doğrulaması çalışmaz.
SHARED_SECRET_BASE32=
AES_SECRET_KEY=

# Eski (crypto-js) karekod biçimini kabul et. Tüm kiosklar güncellenince false yapın.
QR_ACCEPT_LEGACY=true

# Vardiya geç kalma / erken çıkma toleransı (dakika, varsayılan 3)
SHIFT_TOLERANCE_MINUTES=3
